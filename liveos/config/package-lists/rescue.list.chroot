# Live system basics (listed because recommended packages are turned off)
live-boot
live-config
live-config-systemd
user-setup
sudo

# Network: wired DHCP (Wi-Fi can be added later) and clock sync for the secure link
network-manager
systemd-timesyncd
ca-certificates
firmware-realtek
firmware-linux-free

# The PC's screen: one calm page in a full-screen Firefox window, inside the cage kiosk compositor.
# If graphics can't start on a PC, the text screen on tty1 stays.
cage
firefox-esr
fonts-inter
libpam-systemd
dbus
xkb-data
kbd

# Rescue agent runtime (hivex edits the offline Windows registry; hivexsh etc. for expert mode)
python3
python3-venv
python3-hivex
libhivex-bin

# Windows restore points (Volume Shadow Copies)
libvshadow-utils
fuse3

# Backups: disk images of failing disks
gddrescue

# Windows' own repair tools run in a small VM started from the PC's recovery image
qemu-system-x86
ovmf
wimtools
mtools
fdisk

# Disk and boot tools the agent uses
smartmontools
nvme-cli
ntfs-3g
cryptsetup-bin
dosfstools
efibootmgr
mokutil
iproute2

# Hardware information
pciutils
usbutils
dmidecode
lshw
lm-sensors

# For troubleshooting on screen 2 (Alt+F2)
nano
less
