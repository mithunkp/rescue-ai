[Unit]
Description=Rescue AI agent (read-only) with its screen on tty1
After=systemd-udevd.service local-fs.target
Wants=NetworkManager.service
Conflicts=getty@tty1.service

[Service]
Type=simple
Environment=PYTHONIOENCODING=utf-8 LANG=C.UTF-8
ExecStart=/opt/rescue-ai/.venv/bin/python /opt/rescue-ai/rescue_agent.py --console
StandardInput=tty-force
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
