#!/bin/sh
# Bake the Rescue AI agent into the image, so nothing is downloaded at the broken PC.
set -e

# --system-site-packages lets the agent use Debian's python3-hivex
python3 -m venv --system-site-packages /opt/rescue-ai/.venv
/opt/rescue-ai/.venv/bin/pip install --no-cache-dir --disable-pip-version-check \
	-r /opt/rescue-ai/requirements.txt evtx

# cloudflared opens the secure link: one exact version, checked against its published SHA-256
CLOUDFLARED_VERSION=2026.10.7
CLOUDFLARED_SHA256=70b1a1e0f46033ffc8d90b406e554044ba6cbf2e4360295ef1163aed31e09393
python3 -c "import urllib.request, sys; urllib.request.urlretrieve(sys.argv[1], '/tmp/cloudflared.deb')" \
	"https://github.com/cloudflare/cloudflared/releases/download/$CLOUDFLARED_VERSION/cloudflared-linux-amd64.deb"
echo "$CLOUDFLARED_SHA256  /tmp/cloudflared.deb" | sha256sum -c -
dpkg -i /tmp/cloudflared.deb
rm -f /tmp/cloudflared.deb

# The PC's screen (a page in a kiosk window) runs as its own unprivileged user
useradd --system --create-home --home-dir /var/lib/rescue-ui --shell /usr/sbin/nologin rescue-ui
systemctl enable rescue-screen.service

# Screen 1 shows Rescue AI instead of a login prompt
systemctl mask getty@tty1.service
systemctl enable rescue-agent.service NetworkManager.service systemd-timesyncd.service
